!baseq2/pics/flashlight_profile.png
# The NPU upscaler models ship in the repo (they are small), but the directory
# stays ignored by default so that staging baseq2\ from a game install cannot
# silently import whatever model happens to be sitting there. Note the glob:
# "baseq2/models/" would ignore the directory itself, and git cannot un-ignore a
# file inside an ignored directory.
baseq2/models/*
!baseq2/models/quicksrnetsmall-w8a8.onnx
!baseq2/models/quicksrnetsmall.data
!baseq2/models/quicksrnetlarge-w8a8.onnx
!baseq2/models/quicksrnetlarge.data
!baseq2/models/quicksrnetlarge-w8a8.metadata.json
!baseq2/models/quicksrnetlarge-q2rtx-w8a8.onnx
!baseq2/models/compact-temporal-2x-hardgate-w8a8.onnx
!baseq2/models/compact-temporal-2x-hardgate-w8a8.metadata.json
