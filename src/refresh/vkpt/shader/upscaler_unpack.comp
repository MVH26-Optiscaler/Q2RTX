// ========================================================================== //
// NPU upscaler, unpack pass.
//
// Reads the uint8 NCHW output tensors produced by the model (1x3xtile_out x
// tile_out per tile) back into the screen-resolution image that the final blit
// consumes. Inverse of upscaler_pack.comp; see upscaler.c for the overview.
// ========================================================================== //

#version 450
#extension GL_GOOGLE_include_directive    : enable
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier    : enable

#include "utils.glsl"

#define GLOBAL_UBO_DESC_SET_IDX 0
#include "global_ubo.h"

#define GLOBAL_TEXTURES_DESC_SET_IDX 1
#include "global_textures.h"

#include "upscaler_shared.h"

layout(set = 2, binding = 1, std430) readonly buffer OutputTensorBuffer {
	uint output_tensor[];
};

layout(push_constant) uniform PushConstants {
	uint tiles_x;
	uint tiles_y;
	uint tile_in;  // model input  edge, pixels (unused here)
	uint tile_out; // model output edge, pixels
} push;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
	ivec2 ipos = ivec2(gl_GlobalInvocationID.xy);

	// IMG_UPSCALE_OUTPUT is allocated at extent_screen_images, which can be
	// larger than the display. Only the top-left display rect is written, which
	// is exactly what final_blit.frag samples back.
	ivec2 out_size = ivec2(global_ubo.unscaled_width, global_ubo.unscaled_height);

	if (any(greaterThanEqual(ipos, out_size)))
		return;

	// Pack copied the render target into the tile grid 1:1, so the model output
	// is the render target scaled by the model's factor and the screen pixel
	// indexes it 1:1 as well -- no resampling on the way back out either. The
	// clamp crops the overhang when the display is not an exact multiple of the
	// scale factor.
	int scale = int(push.tile_out / push.tile_in);
	ivec2 valid = ivec2(global_ubo.taa_output_width, global_ubo.taa_output_height) * scale;
	ivec2 grid_pos = min(ipos, valid - 1);

	uint tile_x = uint(grid_pos.x) / push.tile_out;
	uint tile_y = uint(grid_pos.y) / push.tile_out;
	uint lx     = uint(grid_pos.x) % push.tile_out;
	uint ly     = uint(grid_pos.y) % push.tile_out;
	uint tile   = tile_y * push.tiles_x + tile_x;

	uint plane_stride = (push.tile_out * push.tile_out) / 4u;

	uint byte_index = ly * push.tile_out + lx;
	uint base  = tile * (3u * plane_stride) + byte_index / 4u;
	uint shift = (byte_index % 4u) * 8u;

	uvec3 bytes;
	bytes.r = (output_tensor[base + 0u * plane_stride] >> shift) & 0xffu;
	bytes.g = (output_tensor[base + 1u * plane_stride] >> shift) & 0xffu;
	bytes.b = (output_tensor[base + 2u * plane_stride] >> shift) & 0xffu;

	vec3 color = upscaler_encoded_to_linear(vec3(bytes) / 255.0);

	imageStore(IMG_UPSCALE_OUTPUT, ipos, vec4(color, 1));
}
