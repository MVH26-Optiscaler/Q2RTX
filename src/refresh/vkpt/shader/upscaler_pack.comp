// ========================================================================== //
// NPU upscaler, pack pass.
//
// Copies the tone-mapped TAA output into the uint8 NCHW input tensor expected
// by the loaded model (1x3xtile_in x tile_in per tile). The frame is covered by
// a tiles_x * tiles_y grid of tile_in-sized tiles; each tile is one inference.
// The copy is 1:1 -- the render extent is derived from the model's scale factor
// so that it does not need resampling -- and the right/bottom remainder of the
// grid is padded by replicating the edge texel. The geometry comes from the
// model via push constants, so this shader does not care which QuickSRNet
// variant is loaded. See upscaler.c.
//
// Each invocation packs 4 horizontally adjacent pixels into one uint so that
// no two invocations write the same dword (GLSL has no uint8 storage).
// ========================================================================== //

#version 450
#extension GL_GOOGLE_include_directive    : enable
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier    : enable

#include "utils.glsl"

#define GLOBAL_UBO_DESC_SET_IDX 0
#include "global_ubo.h"

#define GLOBAL_TEXTURES_DESC_SET_IDX 1
#include "global_textures.h"

layout(set = 2, binding = 0, std430) writeonly buffer InputTensorBuffer {
	uint input_tensor[];
};

layout(push_constant) uniform PushConstants {
	uint tiles_x;
	uint tiles_y;
	uint tile_in;  // model input  edge, pixels
	uint tile_out; // model output edge, pixels (unused here)
	uint src_width;
	uint src_height;
	uint src_is_nss; // 0 = TEX_TAA_OUTPUT, 1 = TEX_NSS_OUTPUT
} push;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
	const uint quads_x = push.tile_in / 4u; // 4 pixels packed per uint

	uvec2 gid = gl_GlobalInvocationID.xy;
	if (gid.x >= push.tiles_x * quads_x || gid.y >= push.tiles_y * push.tile_in)
		return;

	uint tile_x = gid.x / quads_x;
	uint qx     = gid.x % quads_x;
	uint tile_y = gid.y / push.tile_in;
	uint ly     = gid.y % push.tile_in;
	uint tile   = tile_y * push.tiles_x + tile_x;

	// The render target is copied into the tile grid 1:1: the grid is sized to
	// cover it in vkpt_upscaler_do(), so there is nothing to resample here. Any
	// mismatch with the display is resolved on the way back out, by the
	// downsample in upscaler_unpack.comp.
	//
	// Past the render target's right/bottom edge the tile is padded by
	// replicating the edge texel rather than with black, which the model's
	// receptive field would otherwise bleed inward as a dark halo along the last
	// valid row/column.
	//
	// The clamp doubles as the correction for the source pass only filling a
	// top-left sub-rect of an image allocated at the screen-image extent -- true
	// of vkpt_taa()'s extent_taa_output and of NSS's reconstruct alike. Hence the
	// rect comes from a push constant rather than the UBO's taa_output_*: which
	// pass produced the source depends on whether NSS is chained in front.
	ivec2 src_max = ivec2(push.src_width, push.src_height) - 1;
	int grid_y = int(tile_y * push.tile_in + ly);

	uint packed_rgb[3] = uint[3](0u, 0u, 0u);

	for (uint i = 0u; i < 4u; i++)
	{
		int grid_x = int(tile_x * push.tile_in + qx * 4u + i);

		ivec2 src_px = min(ivec2(grid_x, grid_y), src_max);
		vec3 color = (push.src_is_nss != 0u)
			? texelFetch(TEX_NSS_OUTPUT, src_px, 0).rgb
			: texelFetch(TEX_TAA_OUTPUT, src_px, 0).rgb;

		// The tone-mapped values go to the model as they are, with no transfer
		// curve applied. Encoding here and inverting it in unpack would hand the
		// model something closer to the display-referred sRGB it was trained on,
		// but a pow() on either side of the uint8 quantization loses more than
		// the gamut mismatch costs.
		uvec3 bytes = uvec3(round(clamp(color, vec3(0), vec3(1)) * 255.0));

		packed_rgb[0] |= bytes.r << (8u * i);
		packed_rgb[1] |= bytes.g << (8u * i);
		packed_rgb[2] |= bytes.b << (8u * i);
	}

	uint plane_stride = (push.tile_in * push.tile_in) / 4u;
	uint base = tile * (3u * plane_stride) + ly * quads_x + qx;

	input_tensor[base + 0u * plane_stride] = packed_rgb[0];
	input_tensor[base + 1u * plane_stride] = packed_rgb[1];
	input_tensor[base + 2u * plane_stride] = packed_rgb[2];
}
